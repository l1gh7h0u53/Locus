<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fallback Round Background Layer (Circle styled plum backdrop) -->
    <path
        android:pathData="M 54,10 A 44,44 0 1,1 53.99,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="98"
                android:endY="98"
                android:startX="10"
                android:startY="10"
                android:type="linear">
                <item
                    android:color="#240F3E"
                    android:offset="0.0" />
                <item
                    android:color="#0F051D"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <group
        android:scaleX="0.60"
        android:scaleY="0.60"
        android:translateX="21.6"
        android:translateY="21.4">
        <!-- Symmetrical location pin (teardrop shape) -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="7"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M 54,84 C 54,84 29,59 29,43 C 29,29 40.2,18 54,18 C 67.8,18 79,29 79,43 C 79,59 54,84 54,84 Z" />

        <!-- Highly stylized percentage sign inside the pin -->
        <group>
            <!-- The Slash -->
            <path
                android:strokeColor="#FFFFFF"
                android:strokeWidth="5.5"
                android:strokeLineCap="round"
                android:pathData="M 44,53 L 64,33" />
            
            <!-- Left Dot (filled) -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M 42,35 A 4,4 0 1,1 41.99,35 Z" />

            <!-- Right Dot (filled) -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M 66,51 A 4,4 0 1,1 65.99,51 Z" />
        </group>
    </group>
</vector>
